{
  "name": "svetlana-ilina-ux-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:static",
    "build:static": "tsc --noEmit && vite build && node scripts/verify-static-build.mjs",
    "build:sites": "npm run build:static && node scripts/prepare-sites-build.mjs",
    "build:github-pages": "tsc --noEmit && vite build --mode github-pages && node scripts/verify-static-build.mjs --base=/svetlana-ilina/",
    "build:wordpress": "npm run build:static && node scripts/sync-wordpress-theme.mjs",
    "check": "tsc --noEmit",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8"
  }
}
